{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iapp-dl",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
