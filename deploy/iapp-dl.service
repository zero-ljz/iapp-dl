[Unit]
Description=Download redirects and public files
After=network.target

[Service]
Type=simple
User=iapp-dl
Group=iapp-dl
WorkingDirectory=/opt/iapp-dl
ExecStart=/usr/bin/node /opt/iapp-dl/src/node.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
